# Portas locais
SUPPLIES_API_PORT=8082
SUPPLIES_DB_PORT=5434

# Banco de dados
SUPPLIES_DB_NAME=mekano_supplies
SUPPLIES_DB_USER=mekano
SUPPLIES_DB_PASSWORD=mekano

# Registry (Mekano-Registry-Service-API)
# Fora do Docker: http://localhost:8081
# Dentro do Docker Compose: http://host.docker.internal:8081
REGISTRY_URL=http://host.docker.internal:8081
REGISTRY_TIMEOUT_MS=3000
